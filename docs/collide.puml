@startuml collide
title 断尾接管（头 A 撞 B 的第 k 节）

participant "Snake A(撞击者)" as A
participant World
participant "Snake B(被撞者)" as B

World -> B : severAt(k)
activate B
B -> B : 取轨迹上弧长 [k*sp, (n-1)*sp] 的折线\ncolors 截断为前 k 节
B --> World : { 折线点集 pts, 颜色 colors }
deactivate B

World -> A : prependChain(pts, colors)
activate A
A -> A : 以"连接点"为基准平移到 A 头部坐标系\n反转后前置到 A 的轨迹\n新头 = B 原尾端, 朝向沿 B 尾部外侧
A -> A : colors = reverse(colors) ++ A.colors\n超过 maxLength 则截断
A --> World : 完成
deactivate A

World -> World : resolveMatches(A)  // 可能立刻触发连锁三消
World -> World : 广播 hit 事件(玻璃珠撞击音效 + 粒子)
@enduml
